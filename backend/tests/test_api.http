@baseUrl = http://127.0.0.1:8000

### ==========================================
### MÓDULO: CATEGORÍAS
### ==========================================

### 1. Listar categorías (incluye las semillas MUE-01 y ELE-02)
GET {{baseUrl}}/categorias/

### 2. Listar categorías paginado
GET {{baseUrl}}/categorias/?skip=0&limit=1

### 3. Crear categoría -> 201
POST {{baseUrl}}/categorias/
Content-Type: application/json

{
  "codigo": "HER-03",
  "descripcion": "Herramientas Manuales"
}

### 4. Detalle de categoría existente -> 200
GET {{baseUrl}}/categorias/3

### 5. Detalle de categoría inexistente -> 404
GET {{baseUrl}}/categorias/999

### 6. Actualizar categoría (reemplazo total) -> 200
PUT {{baseUrl}}/categorias/3
Content-Type: application/json

{
  "codigo": "HER-03",
  "descripcion": "Herramientas de Jardinería y Taller"
}

### 7. Actualizar categoría inexistente -> 404
PUT {{baseUrl}}/categorias/999
Content-Type: application/json

{
  "codigo": "HER-03",
  "descripcion": "Herramientas de Jardinería y Taller"
}

### 8. Desactivar categoría (borrado lógico) -> 200
PUT {{baseUrl}}/categorias/3/desactivar


### ==========================================
### MÓDULO: PRODUCTOS
### ==========================================

### 9. Crear producto -> 201
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Silla Ergonómica",
  "descripcion": "Silla con apoyabrazos ajustables",
  "categoria": "MUE-01",
  "precio": 250.00,
  "stock": 10,
  "stock_minimo": 5
}

### 10. Crear producto con nombre duplicado -> 409
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Silla Ergonómica",
  "categoria": "MUE-01",
  "precio": 300.00,
  "stock": 5,
  "stock_minimo": 1
}

### 11. Listar productos paginado
GET {{baseUrl}}/productos/?skip=0&limit=5

### 12. Detalle de producto existente -> 200
GET {{baseUrl}}/productos/1

### 13. Detalle de producto inexistente -> 404
GET {{baseUrl}}/productos/99

### 14. Actualizar producto (reemplazo total) -> 200
# Se baja el stock a 3 para forzar la alerta de bajo_stock_minimo
PUT {{baseUrl}}/productos/1
Content-Type: application/json

{
  "nombre": "Silla Ergonómica Premium",
  "categoria": "MUE-01",
  "precio": 299.99,
  "stock": 3,
  "stock_minimo": 5
}

### 15. Actualizar producto inexistente -> 404
PUT {{baseUrl}}/productos/99
Content-Type: application/json

{
  "nombre": "Producto Inexistente",
  "categoria": "MUE-01",
  "precio": 10,
  "stock": 1,
  "stock_minimo": 1
}

### 16. Consultar estado de stock -> 200 (bajo_stock_minimo: true tras el PUT anterior)
GET {{baseUrl}}/productos/1/stock

### 17. Desactivar producto (borrado lógico) -> 200
PUT {{baseUrl}}/productos/1/desactivar

### 18. Crear producto con nombre vacío (solo espacios) -> 422
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "   ",
  "categoria": "MUE-01",
  "precio": 10,
  "stock": 5,
  "stock_minimo": 1
}

### 19. Crear producto con categoría inválida y precio negativo -> 422
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Escritorio Roto",
  "categoria": "MUEBLES",
  "precio": -50.00,
  "stock": 5,
  "stock_minimo": 5
}

### 20. Crear producto con precio 0 -> 422 (precio usa gt=0, ver README)
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Producto Gratis",
  "categoria": "MUE-01",
  "precio": 0,
  "stock": 5,
  "stock_minimo": 1
}
